  "definition_status": "source_limited_single_author",
  "definitions": [
    {
      "source_pages_pdf": "49–62",
      "chapter": "第三章：在物与词之间",
      "authors": ["person_roland_barthes"],
      "definition": "A组表述以较明确的世事为所指；B组表述的所指主要是流行系统自身。两组所指通过不同的文本关系进入时装符号分析。"
    },
    {
      "source_pages_pdf": "222–231",
      "chapter": "第十五章：服饰符号",
      "authors": ["person_roland_barthes"],
      "definition": "A/B区分指向所指呈现方式不同，不是实际衣物与虚假衣物的二分。A组通常保留世事、功能或文化情境；B组更直接依赖时装系统内部的年度代码与对比。"
    }
  ],
